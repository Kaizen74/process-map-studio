# Copy of the settings the app reads. The app creates your real .env from this file.
# Never put your real API key in this file; it is committed to GitHub.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
MOCK_CLAUDE=0
VERIFIER_ENABLED=1
WEB_RESEARCH_ENABLED=0
WEB_SEARCH_TOOL_VERSION=
WEB_SEARCH_MAX_USES_CAP=20
OWNER_NAME=Owner
APP_PORT=8000
DATA_DIR=./data
