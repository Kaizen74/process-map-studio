# Settings template, committed to GitHub: never put a real API key in this file.
# Setup copies it to your private .env. A blank value means the default (PRD section 3.4);
# the app fills in what you change in Settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
MOCK_CLAUDE=
VERIFIER_ENABLED=
WEB_RESEARCH_ENABLED=
WEB_SEARCH_TOOL_VERSION=
WEB_SEARCH_MAX_USES_CAP=
OWNER_NAME=
APP_PORT=
DATA_DIR=
